          "order": 20
        }
      ],
      "sections": [
        {
          "id": "leases.cobranza.generacion-de-los-cargos-del-mes",
          "page": "leases.cobranza",
          "label": "Generación de los cargos del mes",
          "order": 10,
          "items": [
            {
              "key": "leases.charges.generation",
              "type": "enum",
              "label": "Cómo se generan",
              "description": "«A mano»: vos apretás el botón en Cobranzas cuando querés. «Avisarme»: el sistema te recuerda al inicio del mes y generás vos. «Sola»: se generan al empezar el mes sin preguntar. Generándolos dos veces nunca se duplican, así que la diferencia real es cuánta iniciativa querés que tome el sistema.",
              "default": "manual",
              "options": [
                { "value": "manual", "label": "A mano" },
                { "value": "ask", "label": "Avisarme y genero yo" },
                { "value": "auto", "label": "Que se generen solas" }
              ],
              "tags": ["leases", "charges", "generation", "cómo", "generan"]
            }
          ]
        },
        {
          "id": "leases.cobranza.mora",
          "page": "leases.cobranza",
          "label": "Mora",
          "order": 20,
          "items": [
            {
              "key": "leases.lateFee.graceDays",
              "type": "number",
              "label": "Días de gracia",
              "description": "Cuántos días después del vencimiento se puede pagar sin punitorio. Un pago que entra el lunes por un vencimiento del sábado no siempre es una mora: con 0 el interés corre desde el día siguiente.",
              "default": 0,
              "min": 0,
              "max": 30,
              "tags": ["leases", "latefee", "gracedays", "días", "gracia"]
            },
            {
              "key": "leases.lateFee.apply",
              "type": "enum",
              "label": "Cómo se cobra el punitorio",
              "description": "El punitorio nunca se agrega en silencio. «Proponer» lo calcula y espera tu confirmación antes de sumarlo a la cuenta; «no calcular» lo deja fuera del sistema, para quien lo arregla hablando.",
              "default": "propose",
              "options": [
                { "value": "propose", "label": "Proponer y confirmo yo" },
                { "value": "off", "label": "No calcular punitorios" }
              ],
              "tags": [
                "leases",
                "latefee",
                "apply",
                "cómo",
                "cobra",
                "punitorio"
              ]
            }
          ]
        },
        {
          "id": "leases.contratos.valores-por-defecto-de-un-contrato-nuevo",
          "page": "leases.contratos",
          "label": "Valores por defecto de un contrato nuevo",
          "order": 10,
          "items": [
            {
              "key": "leases.contracts.defaultCurrency",
              "type": "enum",
              "label": "Moneda",
              "description": "En qué moneda se pactan tus alquileres habitualmente. Es solo el valor con el que arranca el formulario: cada contrato puede firmarse en la otra.",
              "default": "ARS",
              "options": [
                { "value": "ARS", "label": "Pesos (ARS)" },
                { "value": "USD", "label": "Dólares (USD)" }
              ],
              "tags": ["leases", "contracts", "defaultcurrency", "moneda"]
            },
            {
              "key": "leases.contracts.defaultDueDay",
              "type": "number",
              "label": "Día de vencimiento",
              "description": "Qué día del mes vencen tus alquileres. Cada propietario tiene su costumbre — el 1, el 5, el 10 — y repetirla en cada contrato es tiempo perdido.",
              "default": 10,
              "min": 1,
              "max": 31,
              "tags": [
                "leases",
                "contracts",
                "defaultdueday",
                "día",
                "vencimiento"
              ]
            },
            {
              "key": "leases.contracts.defaultDueDayType",
              "type": "enum",
              "label": "Cómo se cuenta ese día",
              "description": "«Día fijo» vence siempre la misma fecha, caiga como caiga. «Día hábil» corre el vencimiento cuando cae fin de semana o feriado — se usa cuando el pago entra por transferencia y el banco tiene que estar abierto.",
              "default": "fixed",
              "options": [
                { "value": "fixed", "label": "Día fijo del mes" },
                { "value": "business", "label": "Día hábil" }
              ],
              "tags": [
                "leases",
                "contracts",
                "defaultduedaytype",
                "cómo",
                "cuenta",
                "ese",
                "día"
              ]
            },
            {
              "key": "leases.contracts.defaultAdjustmentIndex",
              "type": "enum",
              "label": "Índice de actualización",
              "description": "Con qué índice actualizás los alquileres. Desde la Ley 27.551 el ICL del BCRA es el más usado, pero se pacta libremente.",
              "default": "ICL",
              "options": [
                { "value": "ICL", "label": "ICL (BCRA)" },
                { "value": "IPC", "label": "IPC (INDEC)" },
                { "value": "casa_propia", "label": "Casa Propia" },
                { "value": "fijo", "label": "Escalonado fijo" }
              ],
              "tags": [
                "leases",
                "contracts",
                "defaultadjustmentindex",
                "índice",
                "actualización"
              ]
            },
            {
              "key": "leases.contracts.defaultAdjustmentMonths",
              "type": "enum",
              "label": "Cada cuánto se actualiza",
              "description": "Cada cuántos meses se recalcula el alquiler. Ya no lo fija la ley: se pacta en el contrato.",
              "default": "6",
              "options": [
                { "value": "3", "label": "3 meses" },
                { "value": "4", "label": "4 meses" },
                { "value": "6", "label": "6 meses" },
                { "value": "12", "label": "12 meses" }
              ],
              "tags": [
                "leases",
                "contracts",
                "defaultadjustmentmonths",
                "cada",
                "cuánto",
                "actualiza"
              ]
            }
          ]
        },
        {
          "id": "leases.contratos.contratos-en-dolares",
          "page": "leases.contratos",
          "label": "Contratos en dólares",
          "order": 15,
          "items": [
            {
              "key": "leases.contracts.usdHouse",
              "type": "enum",
              "label": "Con qué dólar se convierte",
              "description": "Un contrato pactado en dólares se cobra en pesos: el cargo se convierte con esta cotización el día que se emite, y queda asentado con qué valor y de qué fecha se hizo la cuenta. Elegí la que dice el contrato — si dice «dólar oficial», poné oficial.",
              "default": "oficial",
              "options": [
                { "value": "oficial", "label": "Oficial" },
                { "value": "blue", "label": "Blue" },
                { "value": "bolsa", "label": "MEP (bolsa)" },
                { "value": "contadoconliqui", "label": "Contado con liqui" },
                { "value": "mayorista", "label": "Mayorista" }
              ],
              "tags": [
                "leases",
                "contracts",
                "usdhouse",
                "qué",
                "dólar",
                "convierte"
              ]
            }
          ]
        },
        {
          "id": "leases.contratos.avisos",
          "page": "leases.contratos",
          "label": "Avisos",
          "order": 20,
          "items": [
            {
              "key": "leases.contracts.expiryWarningDays",
              "type": "number",
              "label": "Marcar «por vencer» con esta anticipación",
              "description": "Cuántos días antes del final un contrato aparece como próximo a vencer. Es el tiempo que te dejás para negociar la renovación o buscar un inquilino nuevo: por debajo de 60 días se llega justo.",
              "default": 60,
              "min": 15,
              "max": 365,
              "tags": [
                "leases",
                "contracts",
                "expirywarningdays",
                "marcar",
                "vencer",
                "esta",
                "anticipación"
              ]
            }
          ]
        }
      ]
    },
