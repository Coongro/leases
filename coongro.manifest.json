        "id": "leases.charges.create",
        "action": "leases.charges.create",
        "generatedBy": "builder",
        "title": "Crear Concepto del contrato",
        "description": "Crea Concepto del contrato con los mismos campos disponibles en el formulario del cliente.",
        "effect": "write",
        "confirmation": "always",
        "inputSchema": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "description": "Datos de Concepto del contrato a crear.",
              "properties": {
                "lease_id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Contrato"
                },
                "type": {
                  "type": "string",
                  "enum": ["abl", "servicio", "expensas", "descuento", "otro"],
                  "description": "Tipo. Opciones: abl (ABL / inmobiliario), servicio (Servicio), expensas (Expensas), descuento (Descuento), otro (Otro).",
                  "default": "servicio"
                },
                "label": {
                  "type": "string",
                  "description": "Como aparece en la factura"
                },
                "amount": {
                  "type": "string",
                  "pattern": "^-?\\d+(?:\\.\\d+)?$",
                  "description": "Importe por mes"
                },
                "valid_from": {
                  "type": "string",
                  "description": "Primer período"
                },
                "valid_to": {
                  "type": "string",
                  "description": "Último período"
                },
                "notes": { "type": "string", "description": "Observaciones" }
              },
              "required": ["lease_id", "type", "label", "amount"],
              "additionalProperties": false
            }
