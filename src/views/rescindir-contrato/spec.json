{
  "specVersion": 1,
  "kind": "panel",
  "title": "Rescindir contrato",
  "blocks": [
    {
      "id": "aviso",
      "kind": "component",
      "comp": "Callout",
      "props": {
        "tone": "warning",
        "title": "El contrato deja de generar cargos",
        "text": "Se guarda la fecha real de fin. El plazo pactado no se modifica: la diferencia entre ambos es lo que fundamenta la multa por rescisión anticipada, si el contrato la prevé. La unidad vuelve a figurar vacante."
      }
    },
    {
      "id": "s1",
      "kind": "container",
      "ctype": "card",
      "label": "La rescisión",
      "icon": "Ban",
      "children": [
        {
          "id": "f_date",
          "kind": "field",
          "name": "terminationDate",
          "fieldType": "date",
          "label": "Último día del contrato",
          "validations": [
            "required"
          ]
        },
        {
          "id": "f_reason",
          "kind": "field",
          "name": "reason",
          "fieldType": "enum",
          "label": "Motivo",
          "validations": [
            "required"
          ],
          "options": [
            {
              "value": "inquilino",
              "label": "El inquilino se va antes"
            },
            {
              "value": "propietario",
              "label": "Decisión del propietario"
            },
            {
              "value": "mutuo_acuerdo",
              "label": "De común acuerdo"
            },
            {
              "value": "incumplimiento",
              "label": "Por incumplimiento"
            }
          ]
        },
        {
          "id": "f_notes",
          "kind": "field",
          "name": "termination_detail",
          "fieldType": "text",
          "label": "Detalle",
          "validations": [],
          "placeholder": "Ej: entregó las llaves el 20/07, quedó a deber el mes de julio"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "container",
      "ctype": "card",
      "label": "Multa por rescisión anticipada",
      "icon": "Gavel",
      "children": [
        {
          "id": "f_penalty",
          "kind": "field",
          "name": "penalty",
          "fieldType": "enum",
          "label": "Qué se hace con la multa",
          "validations": [],
          "options": [
            {
              "value": "cobrar",
              "label": "Cobrarla",
              "icon": "ReceiptText"
            },
            {
              "value": "eximir",
              "label": "No cobrarla",
              "icon": "HandHeart"
            }
          ],
          "help": "Se propone lo que pactó el contrato. Es negociable: se cobra entera, se cobra una parte o se condona."
        },
        {
          "id": "f_penalty_amount",
          "kind": "field",
          "name": "penaltyAmount",
          "fieldType": "money",
          "label": "Importe",
          "validations": [],
          "placeholder": "Ej: 1560000",
          "help": "Se propone lo que pactó el contrato. Si elegís no cobrarla, este importe no se usa."
        }
      ]
    }
  ],
  "data": {
    "submitLabel": "Rescindir contrato",
    "successTitle": "Contrato rescindido",
    "successMessage": "Se guardó la fecha de fin. Deja de generar cargos y la unidad queda vacante."
  },
  "headless": {
    "handlers": [
      {
        "hook": "onInit",
        "mode": "uiOnly",
        "reason": "Propone la fecha de rescisión y el importe de la multa a partir del contrato abierto; no consulta ni modifica datos."
      },
      {
        "hook": "onSubmit",
        "mode": "command",
        "action": "leases.billing.terminateLease",
        "effect": "write",
        "confirmation": "always",
        "preconditions": [
          "El contrato no puede estar ya rescindido.",
          "La fecha no puede ser anterior al inicio del contrato.",
          "La multa sólo se emite si se eligió cobrarla."
        ]
      }
    ]
  }
}