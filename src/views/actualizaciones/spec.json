{
  "specVersion": 1,
  "kind": "blank",
  "title": "Actualizaciones",
  "data": {
    "repositoryPrefix": "leases.adjustments"
  },
  "blocks": [
    {
      "id": "ph",
      "kind": "component",
      "comp": "PageHeader",
      "props": {
        "kicker": "ALQUILERES",
        "title": "Actualizaciones",
        "subtitle": "Los aumentos por índice que el sistema calcula y vos confirmás.",
        "actionLabel": "Buscar actualizaciones",
        "action": {
          "id": "serverAction",
          "label": "Buscar actualizaciones",
          "target": "leases.adjustments.detect",
          "confirm": "Se revisan los contratos que cumplieron su período y se calcula el factor del índice. No se cambia ningún alquiler: cada actualización queda pendiente para que la confirmes."
        }
      }
    },
    {
      "id": "row_kpi",
      "kind": "container",
      "ctype": "columns",
      "alias": "Resumen",
