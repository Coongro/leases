        {
          "fr": 0.34,
          "children": [
            {
              "id": "k1",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Pendientes",
                "value": "0",
                "sub": "esperan tu confirmación",
                "icon": "TrendingUp",
                "tone": "warning"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k2",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Impacto mensual",
                "value": "$0",
                "sub": "si aplicás todas",
                "icon": "Calculator",
                "tone": "neutral"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k3",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Índice de referencia",
                "value": "—",
                "sub": "último valor publicado",
                "icon": "RefreshCw",
                "tone": "success"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tbl",
      "kind": "component",
      "comp": "DataTable",
      "props": {
        "view": "table",
        "density": "compact",
        "mobile": "cards",
        "pageSize": "20",
        "subtitle": "property",
        "expandable": true,
        "columns": [
          {
            "key": "unit",
            "label": "Unidad",
            "emptyLabel": "—"
          },
          {
            "key": "property",
            "label": "Propiedad",
            "emptyLabel": "—"
          },
          {
            "key": "tenant",
            "label": "Inquilino",
            "emptyLabel": "—"
          },
          {
            "key": "index_code",
            "label": "Índice",
            "display": "pill",
            "tone": "outline"
          },
          {
            "key": "rate_percent",
            "label": "Variación",
            "display": "mono",
            "suffix": "%"
          },
          {
            "key": "previous_rent",
            "label": "Alquiler actual",
            "display": "mono",
            "format": "money"
          },
          {
            "key": "new_rent",
            "label": "Nuevo alquiler",
            "display": "mono",
            "format": "money"
          },
          {
            "key": "effective_date",
            "label": "Rige desde",
            "format": "date"
          },
          {
            "key": "status",
            "label": "Estado",
            "display": "pill",
            "values": [
              {
                "value": "pending",
                "label": "Pendiente",
                "tone": "warning",
                "icon": "Clock"
              },
              {
                "value": "applied",
                "label": "Aplicada",
                "tone": "success",
                "icon": "CircleCheck"
              },
              {
                "value": "cancelled",
                "label": "Cancelada",
                "tone": "outline",
                "icon": "CircleSlash"
              }
            ]
          },
          {
            "key": "index_value_from",
            "label": "Índice base",
            "visible": false,
            "display": "mono"
          },
          {
            "key": "index_value_to",
            "label": "Índice al ajuste",
            "visible": false,
            "display": "mono"
          },
          {
            "key": "base_date",
            "label": "Fecha base",
            "visible": false,
            "format": "date"
          }
