        "cells": [
          [
            "3°B",
            "Belgrano 1240",
            "Martina Ruiz",
            "ICL",
            "18,4",
            "485000",
            "574000",
            "2026-09-01",
            "pending",
            "29,52",
            "34,93",
            "2026-03-01"
          ],
          [
            "2°A",
            "Belgrano 1240",
            "Diego Sosa",
            "ICL",
            "22,4",
            "376000",
            "460000",
            "2026-03-01",
            "applied",
            "24,12",
            "29,52",
            "2025-09-01"
          ]
        ],
        "filters": [
          {
            "column": "status",
            "label": "Estado",
            "kind": "select",
            "options": [],
            "default": "pending"
          },
          {
            "column": "index_code",
            "label": "Índice",
            "kind": "select",
            "options": []
          }
        ],
        "actions": [
          {
            "label": "Aplicar",
            "icon": "Check",
            "action": {
              "id": "serverAction",
              "label": "Aplicar",
              "target": "leases.adjustments.apply",
              "confirm": "¿Confirmás la actualización? El alquiler del contrato pasa a valer el monto nuevo desde su fecha.",
              "successToast": "Actualización aplicada"
            }
          },
          {
            "label": "Cancelar",
            "variant": "destructive",
            "icon": "X",
            "action": {
              "id": "serverAction",
              "label": "Cancelar",
              "target": "leases.adjustments.cancel",
              "confirm": "¿Descartás esta actualización? El alquiler queda como estaba.",
              "successToast": "Actualización cancelada"
            }
          }
        ],
        "emptyTitle": "No hay actualizaciones esperando",
        "emptySub": "Cuando un contrato cumpla su período, la actualización aparece acá con el factor ya calculado."
      }
    }
  ],
  "headless": {
    "handlers": [
      {
        "hook": "loadData",
        "mode": "query",
        "action": "leases.adjustments.listDetailed",
        "resource": "leases.adjustments"
      },
      {
        "hook": "loadLiveValues",
        "mode": "query",
        "action": "leases.adjustments.overview",
        "resource": "leases.adjustments"
      },
      {
        "hook": "onAction",
        "mode": "command",
        "action": "leases.adjustments.detect",
        "resource": "leases.adjustments",
        "effect": "write",
        "confirmation": "always"
      }
    ]
  }
}
