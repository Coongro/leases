  ],
  "headless": {
    "handlers": [
      {
        "hook": "loadLiveValues",
        "mode": "query",
        "action": "leases.billing.contractFile"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_ajustes",
        "mode": "query",
        "action": "leases.adjustments.forLease",
        "resource": "leases.adjustments",
        "outputBlockId": "tbl_ajustes"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_cargos",
        "mode": "query",
        "action": "leases.billing.chargesForLease",
        "outputBlockId": "tbl_cargos"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_conceptos",
        "mode": "query",
        "action": "leases.charges.forLease",
        "resource": "leases.charges",
        "outputBlockId": "tbl_conceptos"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_firmantes",
        "mode": "query",
        "action": "leases.coTenants.forLease",
        "resource": "leases.coTenants",
        "outputBlockId": "tbl_firmantes"
      },
      {
        "hook": "onAction",
        "key": "leases.charges.delete",
        "mode": "command",
        "action": "leases.charges.delete",
        "resource": "leases.charges",
        "effect": "destructive",
        "confirmation": "always"
      },
      {
        "hook": "onAction",
        "key": "leases.coTenants.delete",
        "mode": "command",
        "action": "leases.coTenants.delete",
        "resource": "leases.coTenants",
        "effect": "destructive",
        "confirmation": "always"
      }
    ]
  }
}
